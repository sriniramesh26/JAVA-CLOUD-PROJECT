DB_URL="jdbc:mysql://<OCI_IP_OR_HOSTNAME>:3306/smart_traffic?useSSL=true&serverTimezone=UTC"
DB_USER="<OCI_USERNAME>"
DB_PASSWORD="<OCI_PASSWORD>"
